# ---- Database ----
# MVP uses SQLite (no server needed).
# For production (Vercel), switch to Postgres and update prisma/schema.prisma provider.
DATABASE_URL="file:./dev.db"

# ---- LLM provider (for generating summaries) ----
# Choose a FREE provider. No paid service required.
#   ollama  -> free & local, no key, no limits (needs `ollama serve` + a model)
#   groq    -> free tier, very fast (needs a free GROQ_API_KEY)
#   gemini  -> free tier (needs a free GEMINI_API_KEY)
#   openai / anthropic -> paid, optional
LLM_PROVIDER=ollama

# Optional: override the model. Defaults per provider:
#   ollama=llama3.1:8b  groq=llama-3.3-70b-versatile  gemini=gemini-2.0-flash
# LLM_MODEL=

# --- Ollama (default, free/local) ---
# Install from https://ollama.com, then: `ollama pull llama3.1:8b`
OLLAMA_HOST=http://localhost:11434

# --- Groq (free tier) --- get a key at https://console.groq.com
# GROQ_API_KEY=

# --- Gemini (free tier) --- get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# --- Paid options (optional) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=

# ---- Optional ----
# Google Books API key (raises rate limits; discovery works without it)
GOOGLE_BOOKS_API_KEY=

# Secret to protect the cron endpoint. Vercel Cron sends this as a Bearer token.
CRON_SECRET=change-me
