# ---- Required ----
# Anthropic API key for generating summaries
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Database. MVP uses SQLite (no server needed).
# For production (Vercel), switch to Postgres and update prisma/schema.prisma provider.
DATABASE_URL="file:./dev.db"

# ---- Optional ----
# Google Books API key (raises rate limits; discovery works without it)
GOOGLE_BOOKS_API_KEY=

# Model used for summaries. Options: claude-opus-4-8 (best), claude-sonnet-5 (faster/cheaper)
SUMMARY_MODEL=claude-sonnet-5

# Secret to protect the cron endpoint. Vercel Cron sends this as a Bearer token.
CRON_SECRET=change-me
