// Tikbook data model (Postgres).
// 免费数据库：https://neon.tech —— 本地开发与 Vercel 部署共用同一个 DATABASE_URL。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // 免费方案：Neon (neon.tech) 的 serverless Postgres，本地与 Vercel 共用同一连接串
  url      = env("DATABASE_URL")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  source      String // "gutenberg" | "googlebooks"
  externalId  String // id within the source
  coverUrl    String?
  description String?
  hasFullText Boolean  @default(false)
  // Signals used for preference-based selection (stored as JSON arrays).
  genres      Json     @default("[]")
  topics      Json     @default("[]")
  publishYear Int?
  createdAt   DateTime @default(now())

  summary   Summary?
  feedback  Feedback?
  dailyPick DailyPickBook[]

  @@unique([source, externalId])
}

model Summary {
  id        String    @id @default(cuid())
  bookId    String    @unique
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // Pages generated so far: [{ page, title, body }] — filled incrementally
  // in small batches to stay under free-tier LLM rate limits.
  pages     Json
  complete  Boolean   @default(false)
  // Soft lock so concurrent generation drivers don't duplicate work.
  lockedAt  DateTime?
  model     String
  createdAt DateTime  @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  bookId    String   @unique
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  value     String // "like" | "dislike"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A day's selection of 3 books.
model DailyPick {
  id        String          @id @default(cuid())
  date      String          @unique // YYYY-MM-DD
  createdAt DateTime        @default(now())
  books     DailyPickBook[]
}

model DailyPickBook {
  id          String    @id @default(cuid())
  dailyPickId String
  dailyPick   DailyPick @relation(fields: [dailyPickId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reason      String // "preference" | "exploration"
  position    Int

  @@unique([dailyPickId, bookId])
}
